    {
      "role": "MAIN",
      "node": {
        "id": 259352,
        "name": {
          "full": "Shiori Oumi",
          "native": "近江汐莉",
          "alternative": []
        },
        "image": {
          "large": "https://s4.anilist.co/file/anilistcdn/character/large/b259352-bMhNMZFI4fzS.jpg"
        },
        "description": "The new transfer student and [Hinako Yaotose](https://anilist.co/character/250490/Yaotose-Hinako)'s classmate who's secretly a Mermaid. She enrolled to the same academy as Hinako even before summer break with the intent to eat Hinako. She has translucent eyes which resembles the ocean. She has an insightful, mysterious and refined personality.",
        "gender": "Female",
        "age": null
      },
      "voiceActors": [
        {
