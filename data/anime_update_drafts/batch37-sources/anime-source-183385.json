  "characters": [
    {
      "role": "MAIN",
      "node": {
        "id": 250490,
        "name": {
          "full": "Hinako Yaotose",
          "native": "八百歳比名子",
          "alternative": []
        },
        "image": {
          "large": "https://s4.anilist.co/file/anilistcdn/character/large/b250490-uoHFkFhfKP06.jpg"
        },
        "description": "A High school girl living a quiet life in a seaside town, but she feels somewhat detached from her friends during the summer months. She lost her family on a trip when she was six years old. She has a deep, logical, calm and introverted personality. Rarely, she attracts aggressive monsters to her, including sea monsters from the shore.\n\nShe seems to have signs of PTSD.",
        "gender": "Female",
        "age": "16"
      },
