    {
      "role": "SUPPORTING",
      "node": {
        "id": 14337,
        "name": {
          "full": "Ishu Benikawa",
          "native": "紅皮伊舟",
          "alternative": []
        },
        "image": {
          "large": "https://s4.anilist.co/file/anilistcdn/character/large/b14337-2Sv74HSqLLi2.png"
        },
        "description": "The captain of the International Postal ship Zanbani&quot;, she has only a top instead of a shirt, and usually ties her hair in a ponytail with a yellow ribbon, she also wears glasses and is tall. Shes described as being the &quot;sweet, raven haired beauty with glasses&quot; by one of her crew mates. She is the one who calls the shots with the ship, after all she is the captain. Shes strong willed, independent and usually ends up spending her spare money on weapons and ammo; half of the time she is seen drinking or smoking. When around her crew she usually hits or beats them up depending on how stupid she thinks their acts are. Although she may have a tough exterior she does occasionally have a soft spot for her crew.   (Source: Wikipedia)",
        "gender": "Female",
        "age": null
      },
