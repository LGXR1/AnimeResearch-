  "characters": [
    {
      "role": "MAIN",
      "node": {
        "id": 122800,
        "name": {
          "full": "Ange le Carré",
          "native": "アンジェ・ル・カレ",
          "alternative": []
        },
        "image": {
          "large": "https://s4.anilist.co/file/anilistcdn/character/large/n122800-Dbz4d41FJbXg.jpg"
        },
        "description": "Ange is a genius spy with artistic skills. She is adept in telling lies and she can tell when someone is lying to her. She also possesses a special device that allows her to fly for short periods of time. Despite her lying nature, Ange can be shown to be a nice and kind person\n\n~!In Episode 2, it Ange is shown to show her personality only to the [Princess](https://anilist.co/character/122804/Princess).!~\n\n~!It is revealed that her real name is Charlotte.!~\n\n~!During episode 9 it is revealed that Charlotte was accidentally switched with Ange during the start of the revolution. Thus, Charlotte, who is the actual princess took Ange's name and lived on the other side of the wall.!~",
        "gender": "Female",
        "age": "17"
      },
