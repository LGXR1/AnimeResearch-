          "id": 120129,
          "name": {
            "full": "Yuuya Hirose",
            "native": "広瀬裕也"
          },
          "image": {
            "large": "https://s4.anilist.co/file/anilistcdn/staff/large/n120129-V8zB2m0la0IW.png"
          }
        }
      ]
    },
    {
