    {
      "role": "SUPPORTING",
      "node": {
        "id": 2883,
        "name": {
          "full": "Trish",
          "native": "トリッシュ",
          "alternative": []
        },
        "image": {
          "large": "https://s4.anilist.co/file/anilistcdn/character/large/2883.jpg"
        },
        "description": "Trish is a creation of Mundus who bears a great resemblance to Eva, Dante&rsquo;s deceased mother. As a result of her demonic nature she possesses several supernatural abilities, like superhuman strength and lightning powers. In the anime, she has since gone solo but sometimes reappears to work with Dante.  Trish is named after Beatrice Portinari, Dante Alighieri&#039;s guide through Paradise in the Divina Commedia.  (Source: Wikipedia)",
        "gender": null,
        "age": null
      },
