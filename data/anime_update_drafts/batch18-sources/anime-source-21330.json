  "characters": [
    {
      "role": "MAIN",
      "node": {
        "id": 89446,
        "name": {
          "full": "Takeru Fujiwara",
          "native": "藤原尊",
          "alternative": []
        },
        "image": {
          "large": "https://s4.anilist.co/file/anilistcdn/character/large/89446-kQtk8mmjFmUN.jpg"
        },
        "description": "He usually wears glasses, but during practice he uses contacts. He is a first-year student at Honan Academy and is one of the stride club's runners, and predominantly an anchor (final runner).\n\nTakeru is always cool and stoic with sober eyes. He has little interest in things other than playing Stride. In middle school, Takeru was a famous Stride player in the under 15's category. He tends to feel people's legs to determine one's talent. Takeru has great cardiovascular fitness and running speed, so Nana must delay the call for him to start running. Despite this, he only has average parkour techniques.\n\nThe reason for his fixation on Riku is unknown.",
        "gender": "Male",
        "age": null
      },
