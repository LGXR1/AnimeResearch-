    {
      "role": "MAIN",
      "node": {
        "id": 121639,
        "name": {
          "full": "Sistine Fibel",
          "native": "システィーナ フィーベル",
          "alternative": [
            "Sisti",
            "White Cat"
          ]
        },
        "image": {
          "large": "https://s4.anilist.co/file/anilistcdn/character/large/121639-ptCs3mEtYCoL.jpg"
        },
        "description": "Sistine admires magic greatly and wishes to discover the secret of the Flying Castle, which no one knows. She maintains a strict, no-nonsense demeanor throughout, and often scolds [Glenn](https://anilist.co/character/121638/Radars-Glenn) for his lackadaisical attitude. She initially hates Glenn, believing him to be as incompetent as he looked due to his lack of enthusiasm. When he actually starts doing his job, however, she begrudgingly begins to respect Glenn as a highly effective teacher. Her personality and appearance resembles [Sara Silvers](https://anilist.co/character/191611/Silvers-Sara), whom Glenn was very close to. As the series progresses, it seems as though Sistine has developed feelings for Glenn, but is too shy to speak of them. She is called \"Sisti\" by [Rumia](https://anilist.co/character/121640/Tingel-Rumia), and \"White Cat\" by Glenn.",
        "gender": "Female",
        "age": null
      },
      "voiceActors": [
