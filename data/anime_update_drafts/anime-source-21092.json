    {
      "role": "MAIN",
      "node": {
        "id": 88265,
        "name": {
          "full": "Ikki Kurogane",
          "native": "黒鉄一輝",
          "alternative": [
            "Worst One. Failure Knight",
            "Another One",
            "Uncrowned Sword King",
