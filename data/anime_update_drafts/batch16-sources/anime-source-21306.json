    {
      "role": "MAIN",
      "node": {
        "id": 89034,
        "name": {
          "full": "Mai Kawakami",
          "native": "川神舞",
          "alternative": []
        },
        "image": {
          "large": "https://s4.anilist.co/file/anilistcdn/character/large/b89034-K6V63SfSuMjA.png"
        },
        "description": "Mai is a second-year high school student at Hosea Academy and the leader of her Phantom-hunting team. Her ability is called \"Spirit of the Five Elements\", which requires her to  channel a specific element from parts of her body into her fists, using the classic Chinese elemental system.\n\nShe specializes in close combat and fights on the frontline, with Haruhiko backing her up.",
        "gender": "Female",
