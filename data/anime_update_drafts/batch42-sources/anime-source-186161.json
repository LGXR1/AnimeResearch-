    {
      "role": "SUPPORTING",
      "node": {
        "id": 358010,
        "name": {
          "full": "Kisara",
          "native": "キサラ",
          "alternative": []
        },
        "image": {
          "large": "https://s4.anilist.co/file/anilistcdn/character/large/b358010-Fh4nXuwwoFPP.png"
        },
        "description": "A cat-species beastman. She is Tsunagi’s childhood friend, and they were raised together like siblings. She loves Tsunagi deeply and initially harbors a strong sense of rivalry toward Mari, but after coming to know Mari’s straightforward nature, she gradually begins to support the two of them and their relationship. She was wary of humans at first, but through her interactions with Mari and Yukihiro, she grows and matures. She loves fashion and is confident in her sense of style.",
        "gender": "Female",
        "age": "15"
      },
      "voiceActors": [
        {
          "id": 113511,
          "name": {
            "full": "Ai Kakuma",
            "native": "加隈亜衣"
          },
          "image": {
            "large": "https://s4.anilist.co/file/anilistcdn/staff/large/n113511-F58Tk4OFKs1w.jpg"
          }
        }
      ]
    },
    {
      "role": "SUPPORTING",
      "node": {
        "id": 378722,
        "name": {
          "full": "Ayano Shitara",
          "native": "設楽文乃",
          "alternative": []
        },
        "image": {
          "large": "https://s4.anilist.co/file/anilistcdn/character/large/b378722-RKDHjamAelqF.png"
        },
        "description": "A friend and classmate of Mari. Her hobby is writing novels, and her dream is to become a novelist. Her parents, who prioritize studying, allowed her to write novels on the condition that she always get first place in tests, but after meeting Tsunagu, she begins to think about how to face her parents and her dreams. Although she is usually cool, she becomes childishly dependent on her childhood friend Ritsuka. Together with Ritsuka, she supports Mari and Tsunagu's romance.",
        "gender": "Female",
        "age": null
      },
      "voiceActors": [
        {
          "id": 126579,
          "name": {
            "full": "Miyuri Shimabukuro",
