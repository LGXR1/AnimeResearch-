    {
      "role": "MAIN",
      "node": {
        "id": 382213,
        "name": {
          "full": "Kaoru Misogiya",
          "native": "三十木谷薫",
          "alternative": []
        },
        "image": {
          "large": "https://s4.anilist.co/file/anilistcdn/character/large/b382213-s5WUufNSvWUQ.png"
        },
        "description": "The eldest son of the Mitsukiya family. A fifth-grader in elementary school. A boy with blonde hair and blue eyes, he looks like a beautiful Caucasian girl. Because he receives hand-me-down feminine clothes in place of his tomboyish older sister, [Hinata](https://anilist.co/character/382212/), he usually dresses in girls' clothes. He is more outgoing and free-spirited than his sister, and consciously uses his cuteness as a weapon to involve those around him, including adults, and act freely. His spiritual power is above average, but not as high as his sister's.",
        "gender": "Male",
        "age": null
      },
      "voiceActors": [
        {
          "id": 292760,
          "name": {
            "full": "Momoka Terasawa",
            "native": "寺澤百花"
          },
          "image": {
            "large": "https://s4.anilist.co/file/anilistcdn/staff/large/n292760-CnVs8Bk989Bu.jpg"
          }
        }
      ]
    },
    {
      "role": "MAIN",
      "node": {
        "id": 382212,
        "name": {
          "full": "Hinata Misogiya",
          "native": "三十木谷日向",
          "alternative": []
        },
        "image": {
          "large": "https://s4.anilist.co/file/anilistcdn/character/large/b382212-980DzMtrlpiN.png"
        },
        "description": "The eldest daughter of the Mitsukiya family. A second-year middle school student. She has short black hair and a boyish appearance. She has an outgoing personality and often acts together with her younger brother, [Kaoru](https://anilist.co/character/382213/). She is courageous and, even upon first meeting [Dara](https://anilist.co/character/382211/), is not intimidated and quickly becomes friendly with her. She possesses remarkable psychic abilities, to the point that Dara is amazed, and is sensitive to spiritual phenomena that ordinary humans cannot perceive.",
        "gender": "Female",
        "age": "13-"
      },
      "voiceActors": [
        {
          "id": 106492,
          "name": {
            "full": "Minami Tsuda",
            "native": "津田美波"
          },
          "image": {
            "large": "https://s4.anilist.co/file/anilistcdn/staff/large/n106492-9DRvAekKdhDq.png"
          }
        }
      ]
    },
    {
      "role": "SUPPORTING",
      "node": {
        "id": 382215,
        "name": {
          "full": "Chiyo Misogiya",
          "native": "三十木谷千夜",
          "alternative": []
        },
        "image": {
          "large": "https://s4.anilist.co/file/anilistcdn/character/large/b382215-RwVCkp1rzPoS.png"
        },
        "description": "[Hinata](https://anilist.co/character/382212/) and [Kaoru's](https://anilist.co/character/382213/) mother. A middle-aged woman with a voluptuous figure. She closely resembles Hinata in appearance. She has been in charge of managing the forbidden areas and shrines since high school, in place of her father, [Hyougo](https://anilist.co/character/382214/). During her high school years, she was able to perceive [Dara-san](https://anilist.co/character/382211/) and was even saved by her. Because of that experience, she worships Dara-san not as an object of fear, but as a god protecting the cursed objects enshrined in the shrines.",
        "gender": "Female",
        "age": null
      },
